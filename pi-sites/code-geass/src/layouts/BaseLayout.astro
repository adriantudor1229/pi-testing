---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A Code Geass fan site — characters, mechas, and factions. Dark, revolutionary, unforgettable.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8B0000" />
    <meta property="og:title" content={`${title} | Code Geass`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/images/geass-sigil.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | Code Geass</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Font usage:
   * Cinzel — headings, titles, display text (classical imperial feel)
   * Rajdhani — body, UI, stat labels (clean futuristic feel)
   * Fallback to Georgia / system serif
   */
  body {
    font-family: 'Rajdhani', 'Segoe UI', system-ui, sans-serif;
  }

  h1, h2, h3, h4, h5, h6,
  .page-title, .hero-title, .logo-text,
  .card-name, .mecha-name, .comparison-name,
  .faction-tree-title, .members-title {
    font-family: 'Cinzel', 'Georgia', serif;
  }
</style>
