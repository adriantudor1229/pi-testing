---
interface Props {
  id: string;
  name: string;
  faction: string;
  pilot: string;
  classType: string;
  image: string;
  stats: {
    speed: number;
    power: number;
    defense: number;
    mobility: number;
    range: number;
  };
}

const { id, name, faction, pilot, classType, image, stats } = Astro.props;

// Extract generation number for badge
const genMatch = classType.match(/(\d+)/);
const gen = genMatch ? genMatch[1] : '?';

const statLabels: Record<string, string> = {
  speed: 'SPD',
  power: 'PWR',
  defense: 'DEF',
  mobility: 'MOB',
  range: 'RNG',
};
const statEntries = Object.entries(stats);
---

<article class="mecha-card" data-id={id}>
  <div class="card-glow"></div>
  <div class="mecha-image">
    <img src={image} alt={name} loading="lazy" />
    <div class="mecha-image-overlay"></div>
    <span class="gen-badge">GEN {gen}</span>
  </div>
  <div class="mecha-info">
    <div class="mecha-header">
      <h3 class="mecha-name">{name}</h3>
      <span class="mecha-class-badge">{classType}</span>
    </div>
    <div class="mecha-meta">
      <span class="mecha-pilot">👨‍✈️ {pilot}</span>
      <span class="mecha-faction">{faction}</span>
    </div>
    <div class="mecha-stats">
      {statEntries.map(([key, value]) => (
        <div class="stat-row">
          <span class="stat-label">{statLabels[key]}</span>
          <div class="stat-bar-bg">
            <div class="stat-fill" data-width={value * 10}></div>
          </div>
          <span class="stat-num">{value}</span>
        </div>
      ))}
    </div>
  </div>
</article>

<style>
  .mecha-card {
    position: relative;
    background: var(--black-card);
    border: 1px solid rgba(139, 0, 0, 0.2);
    border-radius: 10px;
    overflow: hidden;
    transition: transform var(--transition-med), box-shadow var(--transition-med), border-color var(--transition-med);
  }

  .mecha-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(139, 0, 0, 0.5);
  }

  .card-glow {
    position: absolute;
    inset: -1px;
    border-radius: 10px;
    opacity: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(139, 0, 0, 0.12), transparent 70%);
    transition: opacity var(--transition-med);
    pointer-events: none;
    z-index: 5;
  }

  .mecha-card:hover .card-glow {
    opacity: 1;
  }

  .mecha-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, #0d0d0d, #080808);
    position: relative;
  }

  .mecha-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow), filter var(--transition-med);
  }

  .mecha-card:hover .mecha-image img {
    transform: scale(1.06);
    filter: brightness(1.1) contrast(1.05);
  }

  .mecha-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 40%);
    pointer-events: none;
  }

  .gen-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(139, 0, 0, 0.85);
    color: #fff;
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 3px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 2px 8px rgba(139, 0, 0, 0.4);
    z-index: 2;
  }

  .mecha-info {
    padding: 1.25rem;
    background: linear-gradient(to bottom, var(--black-card), var(--black-light));
  }

  .mecha-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .mecha-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.02em;
  }

  .mecha-class-badge {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--red-bright);
    background: rgba(139, 0, 0, 0.15);
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px solid rgba(139, 0, 0, 0.25);
    white-space: nowrap;
  }

  .mecha-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(139, 0, 0, 0.1);
  }

  .mecha-pilot {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 0.85rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .mecha-faction {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .mecha-stats {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .stat-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-label {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-dim);
    width: 2.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-bar-bg {
    flex: 1;
    height: 5px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .stat-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--red-blood), var(--red-bright));
    border-radius: 3px;
    transition: width 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
  }

  .stat-num {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 0.7rem;
    color: var(--text-dim);
    width: 1.2rem;
    text-align: right;
    font-weight: 600;
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const bars = entry.target.querySelectorAll<HTMLDivElement>('.stat-fill[data-width]');
          bars.forEach((bar, i) => {
            const target = bar.dataset.width ?? '0';
            setTimeout(() => {
              bar.style.width = `${target}%`;
            }, i * 80);
          });
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.2 }
  );

  document.querySelectorAll('.mecha-card').forEach((card) => observer.observe(card));
</script>
