---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/characters', label: 'Characters' },
  { href: '/mechas', label: 'Mechas' },
  { href: '/factions', label: 'Factions' },
];
---

<nav class="nav" id="main-nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo">
      <span class="logo-sigil">◉</span>
      <span class="logo-text">CODE GEASS</span>
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" id="nav-toggle">
      <span class="hamburger">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </span>
    </button>
    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  const nav = document.getElementById('main-nav');

  toggle?.addEventListener('click', () => {
    links?.classList.toggle('open');
    toggle.classList.toggle('active');
  });

  // Close menu on link click (mobile)
  links?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      links.classList.remove('open');
      toggle?.classList.remove('active');
    });
  });

  // Scroll effect: add shadow and darken background
  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (nav) {
      if (scrollY > 50) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    }
    lastScroll = scrollY;
  }, { passive: true });
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(139, 0, 0, 0.2);
    height: var(--nav-height);
    display: flex;
    align-items: center;
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .nav.scrolled {
    background: rgba(0, 0, 0, 0.92);
    border-bottom-color: rgba(139, 0, 0, 0.4);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.5), 0 1px 0 rgba(139, 0, 0, 0.15);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .nav-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-sigil {
    font-size: 1.2rem;
    color: var(--red-glow);
    text-shadow: 0 0 8px rgba(255, 0, 0, 0.5);
    animation: pulseGlow 3s ease-in-out infinite;
    line-height: 1;
  }

  .logo-text {
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    color: var(--red-blood);
    text-transform: uppercase;
    text-shadow: 0 0 10px rgba(139, 0, 0, 0.3);
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast), text-shadow var(--transition-fast);
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-primary);
    border-bottom-color: rgba(139, 0, 0, 0.5);
  }

  .nav-link.active {
    color: var(--text-red);
    border-bottom-color: var(--red-blood);
    text-shadow: 0 0 6px rgba(139, 0, 0, 0.3);
  }

  /* Hamburger button */
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1001;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 24px;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 1px;
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
  }

  .nav-toggle.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
    background: var(--red-bright);
  }

  .nav-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
    background: var(--red-bright);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: block;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.97);
      backdrop-filter: blur(16px);
      flex-direction: column;
      padding: 1.5rem;
      gap: 0.5rem;
      border-bottom: 1px solid var(--red-blood);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .nav-links.open {
      display: flex;
      animation: fadeInUp 0.3s ease both;
    }

    .nav-link {
      font-size: 1.1rem;
      padding: 0.75rem 0;
      border-bottom-width: 1px;
    }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulseGlow {
    0%, 100% { text-shadow: 0 0 8px rgba(255, 0, 0, 0.5); }
    50% { text-shadow: 0 0 16px rgba(255, 0, 0, 0.8), 0 0 30px rgba(139, 0, 0, 0.4); }
  }
</style>
