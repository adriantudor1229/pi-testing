---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeassSigil from '../components/GeassSigil.astro';
---

<BaseLayout title="Home" description="Code Geass fan site — the power of absolute obedience. Dark, revolutionary, unforgettable.">
  <div class="hero">
    <div class="hero-bg"></div>

    <!-- Particle field -->
    <div class="particles" id="particles"></div>

    <!-- Atmospheric fog layers -->
    <div class="fog-layer fog-1"></div>
    <div class="fog-layer fog-2"></div>
    <div class="fog-layer fog-3"></div>

    <!-- Vignette overlay -->
    <div class="vignette"></div>

    <div class="hero-content">
      <div class="sigil-wrapper">
        <div class="sigil-ring"></div>
        <div class="sigil-container">
          <GeassSigil size={250} />
        </div>
      </div>
      <h1 class="hero-title">
        <span class="title-line">CODE</span>
        <span class="title-line title-geass">GEASS</span>
      </h1>
      <p class="hero-tagline">"The power of absolute obedience."</p>
      <p class="hero-subtitle">Lelouch of the Rebellion</p>
      <div class="hero-divider"></div>
      <div class="hero-actions">
        <a href="/characters" class="btn btn-primary">
          <span class="btn-text">Characters</span>
          <span class="btn-glow"></span>
        </a>
        <a href="/mechas" class="btn btn-secondary">
          <span class="btn-text">Knightmares</span>
        </a>
        <a href="/factions" class="btn btn-secondary">
          <span class="btn-text">Factions</span>
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator">
      <div class="scroll-line"></div>
    </div>
  </div>
</BaseLayout>

<script>
  // Create floating particles
  const container = document.getElementById('particles');
  if (container) {
    for (let i = 0; i < 30; i++) {
      const particle = document.createElement('div');
      particle.className = 'particle';
      particle.style.left = `${Math.random() * 100}%`;
      particle.style.top = `${Math.random() * 100}%`;
      particle.style.width = `${Math.random() * 3 + 1}px`;
      particle.style.height = particle.style.width;
      particle.style.animationDelay = `${Math.random() * 8}s`;
      particle.style.animationDuration = `${Math.random() * 10 + 8}s`;
      particle.style.opacity = `${Math.random() * 0.3 + 0.1}`;
      container.appendChild(particle);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: var(--nav-height);
  }

  /* Deep dark background with radial crimson core */
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 45%, rgba(80, 0, 0, 0.25) 0%, transparent 70%),
      radial-gradient(ellipse 80% 60% at 50% 50%, rgba(40, 0, 0, 0.15) 0%, transparent 80%),
      radial-gradient(ellipse at center, #0a0000 0%, #050000 30%, #000000 70%);
    z-index: 0;
  }

  /* Particles */
  .particles {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    background: var(--red-glow);
    border-radius: 50%;
    animation: particleFloat linear infinite;
  }

  @keyframes particleFloat {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    10% { opacity: var(--particle-opacity, 0.2); }
    90% { opacity: var(--particle-opacity, 0.2); }
    100% { transform: translateY(-100vh) translateX(20px); opacity: 0; }
  }

  /* Fog layers with different drift speeds */
  .fog-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .fog-1 {
    background: radial-gradient(ellipse at 20% 80%, rgba(139, 0, 0, 0.06) 0%, transparent 50%);
    animation: fogDrift1 15s ease-in-out infinite alternate;
  }

  .fog-2 {
    background: radial-gradient(ellipse at 80% 20%, rgba(139, 0, 0, 0.04) 0%, transparent 40%);
    animation: fogDrift2 20s ease-in-out infinite alternate;
  }

  .fog-3 {
    background: radial-gradient(ellipse at 50% 50%, rgba(50, 0, 0, 0.08) 0%, transparent 60%);
    animation: fogDrift3 12s ease-in-out infinite alternate;
  }

  @keyframes fogDrift1 {
    0% { transform: translate(0, 0); opacity: 0.5; }
    100% { transform: translate(30px, -20px); opacity: 0.8; }
  }

  @keyframes fogDrift2 {
    0% { transform: translate(0, 0); opacity: 0.6; }
    100% { transform: translate(-25px, 15px); opacity: 1; }
  }

  @keyframes fogDrift3 {
    0% { opacity: 0.3; }
    100% { opacity: 0.7; }
  }

  /* Vignette */
  .vignette {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0, 0, 0, 0.7) 100%);
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem;
    animation: fadeInUp 1s ease both;
    animation-delay: 0.3s;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Sigil wrapper with ring */
  .sigil-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 2.5rem;
    width: 280px;
    height: 280px;
  }

  .sigil-ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid rgba(139, 0, 0, 0.15);
    animation: ringPulse 4s ease-in-out infinite;
  }

  .sigil-ring::before {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid rgba(139, 0, 0, 0.08);
    animation: ringPulse 4s ease-in-out infinite;
    animation-delay: 1s;
  }

  @keyframes ringPulse {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.03); }
  }

  .sigil-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Title */
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-bottom: 0.75rem;
  }

  .title-line {
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0.5em;
    color: var(--text-muted);
    text-transform: uppercase;
    line-height: 1;
  }

  .title-geass {
    font-size: 5rem;
    font-weight: 900;
    letter-spacing: 0.25em;
    color: var(--red-blood);
    text-shadow:
      0 0 30px rgba(139, 0, 0, 0.5),
      0 0 60px rgba(139, 0, 0, 0.2),
      0 2px 4px rgba(0, 0, 0, 0.8);
    line-height: 1.1;
  }

  .hero-tagline {
    font-size: 1.15rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 0.4rem;
    letter-spacing: 0.03em;
  }

  .hero-subtitle {
    font-size: 0.9rem;
    color: var(--text-dim);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .hero-divider {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--red-blood), transparent);
    margin: 0 auto 2rem;
  }

  /* Buttons */
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2.2rem;
    border-radius: 4px;
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all var(--transition-fast);
    cursor: pointer;
    text-decoration: none;
    overflow: hidden;
  }

  .btn-text {
    position: relative;
    z-index: 1;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--red-blood), #6B0000);
    color: #fff;
    border: 1px solid var(--red-blood);
    box-shadow: 0 2px 15px rgba(139, 0, 0, 0.3);
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, var(--red-bright), var(--red-blood));
    border-color: var(--red-bright);
    box-shadow: var(--glow-red-bright), 0 4px 20px rgba(139, 0, 0, 0.5);
    transform: translateY(-2px);
    color: #fff;
  }

  .btn-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: translateX(-100%);
  }

  .btn-primary:hover .btn-glow {
    animation: shimmer 0.6s ease;
  }

  .btn-secondary {
    background: rgba(139, 0, 0, 0.1);
    color: var(--text-primary);
    border: 1px solid rgba(139, 0, 0, 0.35);
  }

  .btn-secondary:hover {
    background: rgba(139, 0, 0, 0.2);
    border-color: var(--red-blood);
    color: var(--red-bright);
    box-shadow: var(--glow-red-soft);
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    opacity: 0.4;
    animation: fadeInUp 1s ease both;
    animation-delay: 1.5s;
  }

  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--red-blood), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 0.7; transform: scaleY(1.2); }
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .title-geass {
      font-size: 3rem;
      letter-spacing: 0.15em;
    }
    .title-line {
      font-size: 1.4rem;
      letter-spacing: 0.3em;
    }
    .sigil-wrapper {
      width: 200px;
      height: 200px;
    }
    .sigil-wrapper :global(.geass-sigil) {
      width: 180px !important;
      height: 180px !important;
    }
    .btn {
      padding: 0.7rem 1.8rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .title-geass {
      font-size: 2.2rem;
    }
    .title-line {
      font-size: 1.1rem;
    }
  }
</style>
