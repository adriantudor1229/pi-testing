---
import BaseLayout from '../layouts/BaseLayout.astro';
import FactionTree from '../components/FactionTree.astro';
import factions from '../data/factions.json';

// Faction relationships for visual indicator
const relationships = [
  { from: 'The Black Knights', to: 'Holy Britannian Empire', type: 'war' },
  { from: 'Geass Order', to: 'Holy Britannian Empire', type: 'alliance' },
  { from: 'Knights of the Round', to: 'Holy Britannian Empire', type: 'subordinate' },
  { from: 'Japan Liberation Front', to: 'The Black Knights', type: 'absorbed' },
];
---

<BaseLayout title="Factions" description="Code Geass factions — empires, rebels, and secret orders.">
  <section class="page-section container">
    <h1 class="page-title">Factions</h1>
    <p class="page-subtitle">The powers that shape the world — and those who defy them.</p>

    {/* Relationships overview */}
    <div class="relationships-bar">
      <div class="rel-item">
        <span class="rel-dot rel-war"></span>
        <span class="rel-label">War</span>
      </div>
      <div class="rel-item">
        <span class="rel-dot rel-alliance"></span>
        <span class="rel-label">Alliance</span>
      </div>
      <div class="rel-item">
        <span class="rel-dot rel-sub"></span>
        <span class="rel-label">Subordinate</span>
      </div>
      <div class="rel-item">
        <span class="rel-dot rel-absorbed"></span>
        <span class="rel-label">Absorbed</span>
      </div>
    </div>

    <div class="factions-list">
      {factions.map((faction, index) => (
        <div class="faction-section" id={faction.id} style={`animation-delay: ${index * 0.1}s`}>
          <div class="faction-banner">
            <div class="faction-banner-bg"></div>
            <div class="faction-header">
              {faction.emblem && (
                <div class="faction-emblem">
                  <img src={faction.emblem} alt={`${faction.name} emblem`} />
                  <div class="emblem-ring"></div>
                </div>
              )}
              <div class="faction-intro">
                <h2 class="faction-name">{faction.name}</h2>
                <p class="faction-leader-text">Led by <strong>{faction.leader}</strong></p>
                <p class="faction-desc">{faction.description}</p>
              </div>
            </div>
          </div>

          {/* Related factions */}
          <div class="faction-relations">
            {relationships
              .filter(r => r.from === faction.name || r.to === faction.name)
              .map(rel => (
                <div class={`relation-chip rel-${rel.type}`}>
                  <span class="rel-dot-small"></span>
                  <span>{rel.from === faction.name ? rel.to : rel.from}</span>
                </div>
              ))
            }
          </div>

          <div class="faction-members">
            <h4 class="members-title">Key Members</h4>
            <div class="members-grid">
              {faction.members.map((member) => (
                <div class="member-chip">
                  <div class="member-avatar">{member.name.charAt(0)}</div>
                  <div class="member-info">
                    <span class="member-name">{member.name}</span>
                    <span class="member-role">{member.role}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="faction-hierarchy">
            <h4 class="members-title">Organization Hierarchy</h4>
            <FactionTree
              name={faction.name}
              leader={faction.leader}
              hierarchy={faction.hierarchy}
            />
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: 4rem;
    min-height: 100vh;
  }

  /* Relationship legend */
  .relationships-bar {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 3rem;
    padding: 1rem;
    background: var(--black-card);
    border-radius: 8px;
    border: var(--border-subtle);
  }

  .rel-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .rel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .rel-war { background: #FF0000; box-shadow: 0 0 6px rgba(255, 0, 0, 0.5); }
  .rel-alliance { background: #FF6600; box-shadow: 0 0 6px rgba(255, 102, 0, 0.4); }
  .rel-sub { background: #8B0000; box-shadow: 0 0 6px rgba(139, 0, 0, 0.4); }
  .rel-absorbed { background: #666666; }

  .rel-label {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Factions list */
  .factions-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .faction-section {
    background: var(--black-card);
    border: 1px solid rgba(139, 0, 0, 0.2);
    border-radius: 12px;
    overflow: hidden;
    animation: fadeInUp 0.6s ease both;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Banner */
  .faction-banner {
    position: relative;
    padding: 2rem;
    overflow: hidden;
  }

  .faction-banner-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(139, 0, 0, 0.08) 0%, transparent 50%, rgba(0, 0, 0, 0.3) 100%);
    pointer-events: none;
  }

  .faction-header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .faction-emblem {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--red-blood);
    flex-shrink: 0;
    background: var(--black-light);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 0 15px rgba(139, 0, 0, 0.2);
  }

  .emblem-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid rgba(139, 0, 0, 0.2);
    pointer-events: none;
  }

  .faction-emblem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .faction-intro {
    flex: 1;
  }

  .faction-name {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    letter-spacing: 0.03em;
  }

  .faction-leader-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .faction-leader-text strong {
    color: var(--red-bright);
  }

  .faction-desc {
    color: var(--text-muted);
    line-height: 1.7;
    font-size: 0.92rem;
  }

  /* Relations */
  .faction-relations {
    display: flex;
    gap: 0.5rem;
    padding: 0 2rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .relation-chip {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.7rem;
    background: var(--black-light);
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .rel-dot-small {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .rel-war .rel-dot-small { background: #FF0000; }
  .rel-alliance .rel-dot-small { background: #FF6600; }
  .rel-sub .rel-dot-small { background: #8B0000; }
  .rel-absorbed .rel-dot-small { background: #666; }

  /* Members */
  .faction-members {
    padding: 0 2rem;
    margin-bottom: 2rem;
  }

  .members-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(139, 0, 0, 0.15);
  }

  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.6rem;
  }

  .member-chip {
    background: var(--black-light);
    border: 1px solid rgba(139, 0, 0, 0.12);
    border-radius: 8px;
    padding: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }

  .member-chip:hover {
    border-color: rgba(139, 0, 0, 0.3);
    background: rgba(139, 0, 0, 0.05);
  }

  .member-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--red-blood), #5a0000);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: 'Cinzel', serif;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .member-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .member-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .member-role {
    font-size: 0.72rem;
    color: var(--red-bright);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Hierarchy */
  .faction-hierarchy {
    padding: 0 2rem 2rem;
  }

  @media (max-width: 768px) {
    .faction-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .faction-relations {
      justify-content: center;
    }

    .members-grid {
      grid-template-columns: 1fr;
    }

    .relationships-bar {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>
